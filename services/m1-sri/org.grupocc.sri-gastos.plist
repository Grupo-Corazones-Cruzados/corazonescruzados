<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.grupocc.sri-gastos</string>
  <!-- Corre DENTRO de la sesión de macOS (Aqua): Chrome necesita poder abrir su ventana. -->
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/fernandogonzalez/.gcc-sri/trabajador.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/fernandogonzalez/.gcc-sri</string>
  <key>RunAtLoad</key><true/>
  <!-- Es un bucle que pregunta cada 30 s: si se cae, launchd lo levanta. -->
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>/tmp/org.grupocc.sri-gastos.out</string>
  <key>StandardErrorPath</key><string>/tmp/org.grupocc.sri-gastos.err</string>
</dict>
</plist>
