# Copia este archivo a .env y rellena los valores.
# La base es la MISMA de Railway que usa GCC WORLD, pero con esquema propio:
#   postgresql://USUARIO:CLAVE@HOST:PUERTO/railway?schema=pedidos
DATABASE_URL=""
# Firma de la sesión (jose). Cualquier cadena larga y aleatoria; distinta por entorno.
JWT_SECRETO=""
# Token del cron que dispara la purga de fin de mes (el MISMO que en nightly-cron).
CRON_TOKEN=""
# Cloudinary — logos de marca y fotos del catálogo. Formato:
#   cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=""
APP_URL="http://localhost:3010"

# Identidad de los clientes de GCC World (reconocer por correo y segundo paso).
# GCC_TOKEN NO es el CRON_TOKEN de este producto: es el de la plataforma, puesto en
# Railway como referencia `${{corazonescruzados.CRON_TOKEN}}`.
GCC_URL=https://app.grupocc.org
GCC_TOKEN=
