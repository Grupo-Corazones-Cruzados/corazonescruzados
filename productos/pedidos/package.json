    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.2",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "pg": "^8.20.0",
    "prisma": "^7.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
