{
  "name": "gcc-pedidos",
  "version": "0.1.0",
  "private": true,
  "description": "Gestión de Pedidos — producto del Grupo Corazones Cruzados. Servicio propio, multi-inquilino.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3011",
    "build": "prisma generate && next build",
