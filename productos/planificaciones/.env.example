# Copia este archivo a .env y rellena los valores.
# La base es la MISMA de Railway que usa GCC WORLD, pero con esquema propio:
#   postgresql://USUARIO:CLAVE@HOST:PUERTO/railway?schema=planificaciones
DATABASE_URL=""
# Firma de la sesión (jose). Cualquier cadena larga y aleatoria; distinta por entorno.
JWT_SECRETO=""
# OpenAI: el agente que redacta (gpt-5.6-luna), la transcripción del micrófono y los embeddings de los adjuntos.
OPENAI_API_KEY=""
# Cloudinary — logos de marca. Formato:
#   cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=""
APP_URL="http://localhost:3013"
